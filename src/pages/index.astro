---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import screenshot1 from '../assets/1.png';
import screenshot2 from '../assets/2.png';

const title = 'Fun Clicker – Play Free Online Browser Clicker Game';
const description =
  'Play Fun Clicker free in your browser — no download. Fast play page for the fun clicker / funklicker game, with a short hub to tips and FAQ.';

const gameUrl = import.meta.env.PUBLIC_GAME_URL ?? 'https://webresources.cc/clicker/fun-clicker.html';
---

<SiteLayout title={title} description={description} canonicalPath="/">
  <section id="game" class="text-center space-y-10">
    <div class="space-y-4">
      <h1 class="hero-text text-5xl md:text-7xl font-black uppercase italic">
        FUN<br />CLICKER.
      </h1>
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-gray-400">
        Play Free Online · No Download · Browser Clicker
      </p>
    </div>

    <div id="game-shell" class="bg-black neo-border shadow-brutal aspect-video overflow-hidden group">
      <iframe
        id="game-frame"
        src={gameUrl}
        data-base-src={gameUrl}
        class="w-full h-full"
        title="Fun Clicker Game Window"
        loading="lazy"
        allowfullscreen
        allow="fullscreen"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <div class="flex justify-center gap-4 text-[10px] font-black uppercase">
      <span class="bg-neo-yellow neo-border px-3 py-1 shadow-brutal-sm">No Download</span>
      <span class="bg-neo-blue neo-border px-3 py-1 shadow-brutal-sm">Desktop + Mobile</span>
    </div>

    <nav class="flex flex-wrap justify-center gap-3 pt-4 text-[10px] font-black uppercase" aria-label="Fun Clicker hub">
      <a href="/#game" class="bg-black text-white neo-border px-4 py-2 shadow-brutal-sm">Play now</a>
      <a href="/guide/" class="bg-neo-yellow neo-border px-4 py-2 shadow-brutal-sm">Tips &amp; FAQ guide</a>
      <a href="/unblocked/" class="bg-neo-blue neo-border px-4 py-2 shadow-brutal-sm">Browser / unblocked notes</a>
    </nav>
    <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest pt-2">
      Also searched as funclicker / funklicker — same Fun Clicker browser game.
    </p>

    <div class="flex justify-center gap-3 pt-2 text-[10px] font-black uppercase">
      <button
        id="btn-fullscreen"
        type="button"
        class="bg-white neo-border px-4 py-2 hover:translate-x-1 hover:translate-y-1 transition-all shadow-brutal-sm"
      >
        FULLSCREEN
      </button>
      <button
        id="btn-reload"
        type="button"
        class="bg-black text-white neo-border px-4 py-2 hover:translate-x-1 hover:translate-y-1 transition-all shadow-brutal-sm"
      >
        RELOAD
      </button>
    </div>

    <script is:inline>
      (() => {
        const frame = document.getElementById('game-frame');
        const shell = document.getElementById('game-shell');
        const btnReload = document.getElementById('btn-reload');
        const btnFullscreen = document.getElementById('btn-fullscreen');

        if (btnReload && frame) {
          btnReload.addEventListener('click', () => {
            const base = frame.getAttribute('data-base-src') || frame.getAttribute('src') || '';
            if (!base) return;
            const url = new URL(base, window.location.href);
            url.searchParams.set('r', String(Date.now()));
            frame.setAttribute('src', url.toString());
          });
        }

        if (btnFullscreen && shell) {
          btnFullscreen.addEventListener('click', async () => {
            try {
              if (!document.fullscreenElement) {
                await shell.requestFullscreen();
              } else {
                await document.exitFullscreen();
              }
            } catch {
              // No-op if fullscreen is blocked by browser policies.
            }
          });
        }
      })();
    </script>
  </section>

  <section id="about" class="space-y-8 bg-gray-50 -mx-6 px-6 py-16">
    <div class="flex flex-col md:flex-row gap-12">
      <div class="md:w-1/3">
        <h2 class="text-3xl font-black uppercase leading-none sticky top-24">ABOUT<br />THIS<br />PAGE.</h2>
      </div>
      <div class="md:w-2/3 space-y-6 text-sm font-medium leading-loose text-gray-700">
        <p>
          This website is an independent fan play page for Fun Clicker (also searched as funclicker or funklicker). Our
          goal is a fast browser embed plus a short hub so you can jump into the game without hunting forums.
        </p>
        <p>
          Deep tips, upgrade path, CPS basics, and troubleshooting live on the
          <a class="underline font-black text-black" href="/guide/">Fun Clicker guide</a>. Notes about playing in your
          browser (soft “unblocked” intent, no filter-bypass promises) are on
          <a class="underline font-black text-black" href="/unblocked/">/unblocked/</a>.
        </p>
        <div class="bg-neo-yellow neo-border p-6 shadow-brutal-sm text-black">
          <h3 class="font-black uppercase mb-2">Original Editorial Note</h3>
          <p>
            The guide text on this site is original writing created for FunClicker.click. The embedded game is served
            from a third-party source and remains the property of its respective owner.
          </p>
        </div>
        <p>
          If the embedded game does not load, use the RELOAD button, switch network, or try a different browser. For
          copyright or ownership concerns, please contact us through the DMCA and Contact pages.
        </p>
      </div>
    </div>
  </section>

  <section id="screenshots" class="space-y-10">
    <div class="space-y-3 text-center">
      <h2 class="text-4xl font-black uppercase italic">Screenshots</h2>
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-gray-400">fun clicker gameplay moments</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <figure class="bg-white neo-border shadow-brutal-sm overflow-hidden">
        <Image
          src={screenshot1}
          alt="fun clicker screenshot showing the game interface"
          class="w-full h-auto"
          loading="lazy"
          decoding="async"
          widths={[622, 1244]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
        <figcaption class="p-4 border-t border-black text-[10px] font-black uppercase tracking-widest text-gray-600">
          fun clicker screenshot 01
        </figcaption>
      </figure>

      <figure class="bg-white neo-border shadow-brutal-sm overflow-hidden">
        <Image
          src={screenshot2}
          alt="fun clicker screenshot with upgraded progression"
          class="w-full h-auto"
          loading="lazy"
          decoding="async"
          widths={[633, 1266]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
        <figcaption class="p-4 border-t border-black text-[10px] font-black uppercase tracking-widest text-gray-600">
          fun clicker screenshot 02
        </figcaption>
      </figure>
    </div>
  </section>

  <section id="mechanics" class="space-y-12 bg-gray-50 -mx-6 px-6 py-16">
    <h2 class="text-4xl font-black uppercase italic text-center">Gameplay Mechanics</h2>

    <div class="grid md:grid-cols-2 gap-12">
      <div class="space-y-6">
        <h3 class="text-xl font-black uppercase bg-black text-white inline-block px-2">Upgrade Path (teaser)</h3>
        <div class="space-y-4">
          <div class="border-l-4 border-black pl-4">
            <p class="font-black text-xs">STEP 1: LOW-COST CLICK BOOSTS</p>
            <p class="text-xs text-gray-500">Buy small upgrades first to leave the slow opening stage.</p>
          </div>
          <div class="border-l-4 border-black pl-4">
            <p class="font-black text-xs">STEP 2: MID-TIER MULTIPLIERS</p>
            <p class="text-xs text-gray-500">Move into medium upgrades once each click starts scaling.</p>
          </div>
        </div>
        <p class="text-xs font-medium text-gray-600">
          Steps 3–4, CPS notes, and pro strategies moved to the
          <a class="underline font-black text-black" href="/guide/">full Fun Clicker guide → /guide/</a>.
        </p>
      </div>

      <div class="bg-neo-blue neo-border p-6 shadow-brutal space-y-4">
        <h3 class="text-xl font-black uppercase">Control Tips</h3>
        <p class="text-xs font-bold leading-relaxed">
          Use quick controls below the frame when the game hangs, stretches, or fails to resize correctly.
        </p>
        <ul class="text-[10px] font-black uppercase space-y-2">
          <li class="flex items-center gap-2"><span class="w-2 h-2 bg-black"></span> FULLSCREEN for focus mode</li>
          <li class="flex items-center gap-2"><span class="w-2 h-2 bg-black"></span> RELOAD for cache-busted refresh</li>
          <li class="flex items-center gap-2"><span class="w-2 h-2 bg-black"></span> Keep browser updated</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="characters" class="space-y-12">
    <h2 class="text-3xl font-black uppercase border-b-4 border-black pb-2">Visual Progression</h2>
    <div class="grid grid-cols-1 gap-12">
      <div class="flex flex-col md:flex-row gap-6">
        <div class="w-20 h-20 bg-neo-green neo-border flex-shrink-0 flex items-center justify-center text-3xl shadow-brutal-sm">
          🙂
        </div>
        <div class="space-y-2">
          <h3 class="font-black uppercase">1. Start Stage</h3>
          <p class="text-sm text-gray-600 leading-relaxed font-medium">
            The interface starts simple and readable, making it easy for new players to learn the basic loop.
          </p>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-6 border-t border-dashed border-black pt-8">
        <div class="w-20 h-20 bg-white neo-border flex-shrink-0 flex items-center justify-center text-3xl shadow-brutal-sm overflow-hidden">
          <span class="grayscale contrast-125">👁️</span>
        </div>
        <div class="space-y-2">
          <h3 class="font-black uppercase">2. Mid Stage</h3>
          <p class="text-sm text-gray-600 leading-relaxed font-medium">
            Visual details become denser while upgrade options expand, which helps players track momentum.
          </p>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-6 border-t border-dashed border-black pt-8">
        <div class="w-20 h-20 bg-black text-white neo-border flex-shrink-0 flex items-center justify-center text-3xl shadow-brutal-sm">
          ⭐
        </div>
        <div class="space-y-2">
          <h3 class="font-black uppercase italic">3. Late Stage</h3>
          <p class="text-sm text-gray-600 leading-relaxed font-medium">
            Late-game visuals are stylized and dramatic. Focus on upgrade efficiency to maintain progression speed.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="grid md:grid-cols-2 gap-8 border-none">
    <div class="bg-black text-white p-8 neo-border shadow-brutal space-y-6">
      <h2 class="text-2xl font-black uppercase italic text-neo-yellow">Pro Strategies</h2>
      <div class="space-y-4 text-xs font-bold tracking-wide">
        <div>
          <p class="text-neo-blue">01. Warm-Up Burst</p>
          <p class="opacity-70">Start with quick manual taps to afford your first upgrade sooner.</p>
        </div>
        <div>
          <p class="text-neo-blue">02. Compare Cost vs Gain</p>
          <p class="opacity-70">Prioritize upgrades with the best return over the next one to two minutes.</p>
        </div>
      </div>
      <a
        href="/guide/#strategies"
        class="inline-block text-[10px] font-black uppercase bg-neo-yellow text-black neo-border px-4 py-2 shadow-brutal-sm"
      >
        Full Fun Clicker guide → /guide/
      </a>
    </div>

    <div class="bg-white p-8 neo-border shadow-brutal space-y-6">
      <h2 class="text-2xl font-black uppercase">Ownership And Credits</h2>
      <p class="text-xs font-medium leading-loose text-gray-600">
        FunClicker.click is not the official game publisher. We provide an embedded play window and original tutorial
        text for convenience. Rights to the game itself belong to its original creator or hosting platform.
      </p>
      <div class="pt-4 border-t-2 border-black flex items-center justify-between text-[10px] font-black uppercase">
        <span>Independent Guide Site</span>
        <span>Original Page Copy</span>
      </div>
    </div>
  </section>

  <section id="faq" class="space-y-12">
    <h2 class="text-3xl font-black uppercase italic bg-neo-pink inline-block px-2">Essential FAQ</h2>
    <div class="divide-y-2 divide-black">
      <details class="py-6 group cursor-pointer">
        <summary class="font-black text-lg uppercase flex justify-between items-center list-none">
          How do I save my progress in fun clicker?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-4 text-sm font-medium text-gray-600 italic">
          Most builds use local browser storage. If you clear site data, your progress may reset. More detail in the
          <a class="underline font-black text-black" href="/guide/#faq">guide FAQ</a>.
        </p>
      </details>

      <details class="py-6 group cursor-pointer">
        <summary class="font-black text-lg uppercase flex justify-between items-center list-none">
          Is fun clicker free to play here?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-4 text-sm font-medium text-gray-600 italic">
          Yes. This page provides browser access without requiring a download or APK.
        </p>
      </details>

      <details class="py-6 group cursor-pointer">
        <summary class="font-black text-lg uppercase flex justify-between items-center list-none">
          Does fun clicker work on mobile?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-4 text-sm font-medium text-gray-600 italic">
          Usually yes. If taps do not register, reload the frame or try a different mobile browser.
        </p>
      </details>

      <details class="py-6 group cursor-pointer">
        <summary class="font-black text-lg uppercase flex justify-between items-center list-none">
          Why is the game not loading?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-4 text-sm font-medium text-gray-600 italic">
          Check your connection, disable strict blockers temporarily, and use the RELOAD button.
        </p>
      </details>

      <details class="py-6 group cursor-pointer">
        <summary class="font-black text-lg uppercase flex justify-between items-center list-none">
          Is this the official game website?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-4 text-sm font-medium text-gray-600 italic">
          No. FunClicker.click is an independent guide and play page.
        </p>
      </details>

      <details class="py-6 group cursor-pointer">
        <summary class="font-black text-lg uppercase flex justify-between items-center list-none">
          How can I contact the site owner?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-4 text-sm font-medium text-gray-600 italic">
          Email contact@funclicker.click or use our <a class="underline font-black text-black" href="/contact">Contact</a>
          page.
        </p>
      </details>

      <details class="py-6 group cursor-pointer">
        <summary class="font-black text-lg uppercase flex justify-between items-center list-none">
          Is Fun Clicker a horror game?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-4 text-sm font-medium text-gray-600 italic">
          Some playthroughs feel light at first and get darker or weirder as upgrades stack. This site is a casual
          browser play hub — see the <a class="underline font-black text-black" href="/guide/">Fun Clicker guide</a> for
          what to expect, not a separate “horror edition” page.
        </p>
      </details>

      <details class="py-6 group cursor-pointer">
        <summary class="font-black text-lg uppercase flex justify-between items-center list-none">
          What is the “silence” Fun Clicker version?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-4 text-sm font-medium text-gray-600 italic">
          People sometimes search quiet or “silence” variants. We embed the standard browser build here and do not ship
          a separate silence landing page.
        </p>
      </details>

      <details class="py-6 group cursor-pointer">
        <summary class="font-black text-lg uppercase flex justify-between items-center list-none">
          Is this the Scratch / scratch clicker game?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-4 text-sm font-medium text-gray-600 italic">
          Fun Clicker is often associated with Scratch-style clicker experiments. We provide a browser embed for
          convenience; it may not match every Scratch remix name-for-name.
        </p>
      </details>

      <details class="py-6 group cursor-pointer">
        <summary class="font-black text-lg uppercase flex justify-between items-center list-none">
          Fun Clicker 2 / version 2?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-4 text-sm font-medium text-gray-600 italic">
          Searches for “version 2” usually mean an updated build or a lookalike. We focus on the current playable embed
          on this site rather than a fake multi-version directory.
        </p>
      </details>
    </div>
    <p class="text-xs font-medium text-gray-500">
      More troubleshooting (CPS, fullscreen, frozen frame, cookies/ads) →
      <a class="underline font-black text-black" href="/guide/#faq">/guide/#faq</a>
    </p>
  </section>
</SiteLayout>
